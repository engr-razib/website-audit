# Apache Server Configuration for Next.js Static Export SPA Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct file or directory existing request
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Map route requests (e.g. /dashboard or /dashboard/) to /dashboard/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 3. Map route requests to route.html if exists
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. Fallback to root index.html for dynamic SPA routes
  RewriteRule ^ index.html [L]
</IfModule>

# Custom 404 Page (points to static 404.html generated by Next.js)
ErrorDocument 404 /404.html
